# Secrets and local configuration
**/.env
**/.env.*
!**/.env.example
!**/*.env.example
!.env.production.example

# Python
**/.venv/
/.uv-cache/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/pytest-cache-files-*/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/

# Node / frontend build
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
**/*.tsbuildinfo

# IDE and OS
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db

# Runtime workspaces and logs
**/logs/
**/*.log
**/.runtime/
**/backups/
