# Application
APP_NAME=SWMM Modeling and Simulation API
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# PostgreSQL database. The database name is case-sensitive: fenhuModel
DATABASE_URL=postgresql+psycopg2://postgres:change-me@127.0.0.1:5432/fenhuModel
DATABASE_NAME=fenhuModel

# Temporary runtime workspace. Persistent artifacts belong in MinIO.
RUNTIME_DIR=.runtime
SWMM_INPUT_CRS=EPSG:4549
# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET=swmm-artifacts
MINIO_CONNECT_TIMEOUT_SECONDS=2
MINIO_READ_TIMEOUT_SECONDS=10
