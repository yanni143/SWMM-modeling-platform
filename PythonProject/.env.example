# Application
APP_NAME=SWMM Modeling and Simulation API
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://223.2.33.21,http://223.2.33.21:5173

# PostgreSQL database. The database name is case-sensitive: fenhuModel
DATABASE_URL=postgresql+psycopg2://postgres:change-me@127.0.0.1:5432/fenhuModel
DATABASE_NAME=fenhuModel

# Temporary runtime workspace. Persistent artifacts belong in MinIO.
RUNTIME_DIR=.runtime
SWMM_INPUT_CRS=EPSG:4549
FIXED_MODEL_ID=00000000-0000-0000-0000-000000000001
FIXED_VERSION_ID=00000000-0000-0000-0000-000000000101
FIXED_MODEL_NAME=汾湖演示研究区
FIXED_MODEL_DESCRIPTION=系统内置的固定 SWMM 演示研究区
FIXED_INP_PATH=resources/fixed-study-area.inp

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET=swmm-artifacts
PRESIGNED_URL_EXPIRES_SECONDS=3600
MINIO_CONNECT_TIMEOUT_SECONDS=2
MINIO_READ_TIMEOUT_SECONDS=10
