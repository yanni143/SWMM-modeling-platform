# The application only listens on the server loopback interface. The existing
# host Nginx proxies public traffic to this port.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=18084

# Frontend values are embedded at image build time. A Mapbox public token is
# visible in the browser, so restrict its allowed URLs in the Mapbox dashboard.
VITE_API_BASE_URL=/
VITE_MAPBOX_ACCESS_TOKEN=replace-with-your-mapbox-public-token

# PostgreSQL
POSTGRES_DB=fenhuModel
POSTGRES_USER=swmm
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg2://swmm:replace-with-a-long-random-password@db:5432/fenhuModel
DATABASE_NAME=fenhuModel

# Backend
APP_NAME=SWMM Modeling and Simulation API
APP_ENV=production
CORS_ORIGINS=http://localhost
RUNTIME_DIR=/app/.runtime
SWMM_INPUT_CRS=EPSG:4549
FIXED_MODEL_ID=00000000-0000-0000-0000-000000000001
FIXED_VERSION_ID=00000000-0000-0000-0000-000000000101
FIXED_MODEL_NAME=汾湖演示研究区
FIXED_MODEL_DESCRIPTION=系统内置的固定 SWMM 演示研究区
FIXED_INP_PATH=/app/resources/fixed-study-area.inp
UVICORN_WORKERS=1

# MinIO is private inside the Docker network.
MINIO_ROOT_USER=swmmadmin
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=swmmadmin
MINIO_SECRET_KEY=replace-with-another-long-random-password
MINIO_SECURE=false
MINIO_BUCKET=swmm-artifacts
MINIO_CONNECT_TIMEOUT_SECONDS=2
MINIO_READ_TIMEOUT_SECONDS=30
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
